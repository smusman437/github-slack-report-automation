      "parameters": {
        "jsCode": "const aiResponse = $json.output;\nlet aiSummaryText = \"\";\nif (aiResponse && aiResponse[0] && aiResponse[0].content && aiResponse[0].content[0]) {\n  aiSummaryText = aiResponse[0].content[0].text || \"\";\n}\n\nconst originalData = $('Aggregate Commits').first().json;\nconst reportLabel = $('Set Report Config').first().json.reportLabel || \"Commit\";\nconst headerText = \"*📊 \" + reportLabel + \" Summary*\\n\\n\";\n\nlet finalMessage = headerText;\nif (aiSummaryText) {\n  finalMessage += \"_\" + aiSummaryText.trim() + \"_\\n\\n\";\n}\n\n// Strip whatever header the upstream node used, dynamically, not hardcoded\nconst bodyWithoutHeader = originalData.message.replace(/^\\*📊[^\\n]*\\*\\n\\n/, \"\");\nfinalMessage += bodyWithoutHeader;\n\nreturn [{ json: { message: finalMessage } }];"
      },
