    {
      "parameters": {
        "jsCode": "const repoData = $(\"Loop Org Repos\").first().json;\nconst prData = $(\"Filter My PRs\").first().json;\nconst commits = items;\n\nif (commits.length === 0) {\n  return [];\n}\n\nconst validCommits = commits.filter(\n  (c) => c.json && c.json.sha && c.json.commit\n);\n\nif (validCommits.length === 0) {\n  return [];\n}\n\nfunction isMergeCommit(message) {\n  return (\n    message.startsWith(\"Merge branch\") ||\n    message.startsWith(\"Merge pull request\") ||\n    message.startsWith(\"Merge remote-tracking branch\")\n  );\n}\n\nconst filteredCommits = validCommits\n  .map((c) => ({\n    sha: c.json.sha.slice(0, 7),\n    message: c.json.commit.message.split(\"\\n\")[0],\n    author: c.json.commit.author ? c.json.commit.author.name : null,\n    date: c.json.commit.author ? c.json.commit.author.date : null,\n  }))\n  .filter((c) => !isMergeCommit(c.message));\n\nif (filteredCommits.length === 0) {\n  return [];\n}\n\nreturn [\n  {\n    json: {\n      repo: repoData.full_name,\n      source_type: \"organization\",\n      pr_number: prData.number,\n      pr_title: prData.title,\n      branch: prData.head ? prData.head.ref : null,\n      commits: filteredCommits,\n    },\n  },\n];"
      },
