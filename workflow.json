    {
      "parameters": {
        "jsCode": "const allRepoCommits = items;\nif (allRepoCommits.length === 0) {\n  return [{ json: { message: \"No commits found in the last week\", groupedData: [] } }];\n}\n\nconst allEntries = [];\nfor (const item of allRepoCommits) {\n  const data = item.json.data ? item.json.data : [item.json];\n  for (const repoData of data) {\n    if (!repoData.commits || repoData.commits.length === 0) continue;\n    allEntries.push(repoData);\n  }\n}\n\nconst grouped = {};\nfor (const repoData of allEntries) {\n  const key = repoData.repo + \"::\" + (repoData.pr_number || \"none\");\n  if (!grouped[key]) {\n    grouped[key] = {\n      repo: repoData.repo,\n      source_type: repoData.source_type,\n      branch: repoData.branch,\n      pr_number: repoData.pr_number,\n      commits: []\n    };\n  }\n  for (const commit of repoData.commits) {\n    if (!commit.sha || !commit.message) continue;\n    const alreadyThere = grouped[key].commits.some(c => c.sha === commit.sha);\n    if (!alreadyThere) {\n      grouped[key].commits.push(commit);\n    }\n  }\n}\n\nconst groupedList = Object.values(grouped).filter(g => g.commits.length > 0);\n\nif (groupedList.length === 0) {\n  return [{ json: { message: \"No commits found in the last week\", groupedData: [] } }];\n}\n\nconst personalRepos = groupedList.filter(g => g.source_type === \"personal\");\nconst orgRepos = groupedList.filter(g => g.source_type !== \"personal\")\n  .sort((a, b) => a.repo.localeCompare(b.repo));\n\nlet totalCommits = 0;\nlet personalCommits = 0;\nlet orgCommits = 0;\nlet message = \"*📊 Weekly Commit Summary*\\n\\n\";\n\nif (personalRepos.length > 0) {\n  message += \"*🧑‍💻 Personal*\\n\";\n  for (const repoData of personalRepos) {\n    personalCommits += repoData.commits.length;\n    totalCommits += repoData.commits.length;\n    message += \"\\n*\" + repoData.repo + \"*\\n\";\n    for (const commit of repoData.commits) {\n      message += \"  • `\" + commit.sha + \"` \" + commit.message + \"\\n\";\n    }\n  }\n  message += \"\\n\";\n}\n\nif (orgRepos.length > 0) {\n  message += \"*🏢 Organization*\\n\";\n  for (const repoData of orgRepos) {\n    orgCommits += repoData.commits.length;\n    totalCommits += repoData.commits.length;\n    const branchInfo = repoData.branch ? \" [\" + repoData.branch + \"]\" : \"\";\n    const prInfo = repoData.pr_number ? \" PR #\" + repoData.pr_number : \"\";\n    message += \"\\n*\" + repoData.repo + \"*\" + branchInfo + prInfo + \"\\n\";\n    for (const commit of repoData.commits) {\n      message += \"  • `\" + commit.sha + \"` \" + commit.message + \"\\n\";\n    }\n  }\n  message += \"\\n\";\n}\n\nmessage += \"*Total: \" + totalCommits + \" commits* (\" + personalCommits + \" personal, \" + orgCommits + \" organization)\";\n\nreturn [{\n  json: {\n    message: message,\n    commit_count: totalCommits,\n    personal_count: personalCommits,\n    org_count: orgCommits,\n    groupedData: groupedList   // <-- new: clean structured data for OpenAI\n  }\n}];"
      },
